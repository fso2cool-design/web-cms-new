{
  "entities": {
    "SchoolProfile": {
      "title": "SchoolProfile",
      "description": "Profil lengkap sekolah Indonesia",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "shortName": { "type": "string", "maxLength": 50 },
        "npsn": { "type": "string", "maxLength": 20 },
        "accreditation": { "type": "string", "maxLength": 10 },
        "slogan": { "type": "string", "maxLength": 300 },
        "description": { "type": "string", "maxLength": 2000 },
        "history": { "type": "string", "maxLength": 5000 },
        "vision": { "type": "string", "maxLength": 1000 },
        "mission": { "type": "string", "maxLength": 3000 },
        "address": { "type": "string", "maxLength": 500 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "whatsapp": { "type": "string", "maxLength": 50 },
        "principalName": { "type": "string", "maxLength": 150 },
        "principalSpeech": { "type": "string", "maxLength": 5000 },
        "principalPhoto": { "type": "string", "maxLength": 500 },
        "logoUrl": { "type": "string", "maxLength": 500 },
        "studentCount": { "type": "number" },
        "teacherCount": { "type": "number" },
        "classCount": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "npsn"]
    },
    "News": {
      "title": "News",
      "description": "Artikel dan berita kegiatan sekolah",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 300 },
        "slug": { "type": "string", "maxLength": 300 },
        "excerpt": { "type": "string", "maxLength": 500 },
        "content": { "type": "string", "maxLength": 50000 },
        "featuredImage": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "maxLength": 100 },
        "author": { "type": "string", "maxLength": 100 },
        "authorId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["draft", "published", "archived"] },
        "publishedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "slug", "content", "status"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Pengumuman resmi sekolah",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 300 },
        "content": { "type": "string", "maxLength": 10000 },
        "priority": { "type": "string", "enum": ["normal", "important", "urgent"] },
        "status": { "type": "string", "enum": ["draft", "published", "archived"] },
        "attachmentUrl": { "type": "string", "maxLength": 500 },
        "date": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "content", "status", "date"]
    },
    "Event": {
      "title": "Event",
      "description": "Agenda dan kalender kegiatan sekolah",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 300 },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "time": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 3000 },
        "category": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["draft", "published"] }
      },
      "required": ["title", "startDate", "location", "status"]
    },
    "Teacher": {
      "title": "Teacher",
      "description": "Data guru dan tenaga kependidikan sekolah",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 150 },
        "nip": { "type": "string", "maxLength": 50 },
        "role": { "type": "string", "maxLength": 100 },
        "subject": { "type": "string", "maxLength": 100 },
        "education": { "type": "string", "maxLength": 100 },
        "photo": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "enum": ["kepala_sekolah", "guru", "wali_kelas", "tenaga_administrasi", "pustakawan", "laboran", "staf"] },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["name", "role", "category", "isActive"]
    },
    "Achievement": {
      "title": "Achievement",
      "description": "Prestasi membanggakan siswa dan sekolah",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 300 },
        "studentName": { "type": "string", "maxLength": 200 },
        "level": { "type": "string", "enum": ["Sekolah", "Kecamatan", "Kabupaten/Kota", "Provinsi", "Nasional", "Internasional"] },
        "rank": { "type": "string", "maxLength": 100 },
        "organizer": { "type": "string", "maxLength": 200 },
        "year": { "type": "string", "maxLength": 10 },
        "photo": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 1000 }
      },
      "required": ["title", "studentName", "level", "rank", "year"]
    },
    "Gallery": {
      "title": "Gallery",
      "description": "Album foto dan kegiatan sekolah",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 300 },
        "description": { "type": "string", "maxLength": 1000 },
        "coverUrl": { "type": "string", "maxLength": 500 },
        "date": { "type": "string" },
        "images": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "coverUrl", "status"]
    },
    "Facility": {
      "title": "Facility",
      "description": "Fasilitas sarana dan prasarana sekolah",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "photo": { "type": "string", "maxLength": 500 },
        "condition": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["draft", "published"] }
      },
      "required": ["name", "status"]
    },
    "Extracurricular": {
      "title": "Extracurricular",
      "description": "Ekstrakurikuler dan pengembangan minat bakat",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 150 },
        "mentor": { "type": "string", "maxLength": 150 },
        "schedule": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 1000 },
        "photo": { "type": "string", "maxLength": 500 },
        "isActive": { "type": "boolean" }
      },
      "required": ["name", "isActive"]
    },
    "Document": {
      "title": "Document",
      "description": "Pusat unduhan dokumen publik dan akademik",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 250 },
        "description": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "maxLength": 100 },
        "fileUrl": { "type": "string", "maxLength": 500 },
        "fileName": { "type": "string", "maxLength": 200 },
        "fileSize": { "type": "string", "maxLength": 50 },
        "downloadCount": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "fileUrl", "category", "status"]
    },
    "PPDBApplicant": {
      "title": "PPDBApplicant",
      "description": "Data pendaftar calon siswa baru PPDB / SPMB",
      "type": "object",
      "properties": {
        "registrationNumber": { "type": "string", "maxLength": 50 },
        "fullName": { "type": "string", "maxLength": 150 },
        "nik": { "type": "string", "maxLength": 20 },
        "nisn": { "type": "string", "maxLength": 20 },
        "birthPlace": { "type": "string", "maxLength": 100 },
        "birthDate": { "type": "string", "maxLength": 50 },
        "gender": { "type": "string", "enum": ["L", "P"] },
        "address": { "type": "string", "maxLength": 500 },
        "previousSchool": { "type": "string", "maxLength": 200 },
        "parentName": { "type": "string", "maxLength": 150 },
        "parentPhone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 150 },
        "chosenMajor": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["draft", "submitted", "verified", "rejected", "accepted", "notAccepted"] },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["registrationNumber", "fullName", "nisn", "parentPhone", "status"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Pesan kontak masuk dari masyarakat/orang tua",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "subject": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 3000 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "message"]
    },
    "FAQ": {
      "title": "FAQ",
      "description": "Daftar tanya jawab umum seputar sekolah",
      "type": "object",
      "properties": {
        "question": { "type": "string", "maxLength": 300 },
        "answer": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string", "maxLength": 100 },
        "order": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "published"] }
      },
      "required": ["question", "answer", "status"]
    },
    "Review": {
      "title": "Review",
      "description": "Ulasan, testimoni, dan rating madrasah dari publik",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string" },
        "isVerified": { "type": "boolean" }
      },
      "required": ["name", "rating", "comment", "status"]
    },
    "VisitorAnalytics": {
      "title": "VisitorAnalytics",
      "description": "Dokumen agregat statistik kunjungan website",
      "type": "object",
      "properties": {
        "today": { "type": "number" },
        "yesterday": { "type": "number" },
        "last7Days": { "type": "number" },
        "last30Days": { "type": "number" },
        "total": { "type": "number" },
        "dailyCounts": { "type": "object" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["today", "total"]
    }
  },
  "firestore": {
    "/schoolProfile/general": {
      "schema": "SchoolProfile",
      "description": "Dokumen tunggal profil sekolah dan sambutan kepala sekolah"
    },
    "/news/{newsId}": {
      "schema": "News",
      "description": "Koleksi artikel dan berita sekolah"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Koleksi pengumuman resmi"
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Koleksi agenda kegiatan sekolah"
    },
    "/teachers/{teacherId}": {
      "schema": "Teacher",
      "description": "Koleksi guru dan staf kependidikan"
    },
    "/achievements/{achievementId}": {
      "schema": "Achievement",
      "description": "Koleksi prestasi siswa dan sekolah"
    },
    "/galleries/{galleryId}": {
      "schema": "Gallery",
      "description": "Koleksi album foto kegiatan sekolah"
    },
    "/facilities/{facilityId}": {
      "schema": "Facility",
      "description": "Koleksi fasilitas sekolah"
    },
    "/extracurriculars/{extracurricularId}": {
      "schema": "Extracurricular",
      "description": "Koleksi ekstrakurikuler sekolah"
    },
    "/documents/{documentId}": {
      "schema": "Document",
      "description": "Koleksi berkas unduhan publik"
    },
    "/ppdbApplicants/{applicantId}": {
      "schema": "PPDBApplicant",
      "description": "Koleksi data pendaftaran calon siswa baru"
    },
    "/contactMessages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Koleksi pesan masuk kontak website"
    },
    "/faqs/{faqId}": {
      "schema": "FAQ",
      "description": "Koleksi tanya jawab umum sekolah"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Koleksi ulasan dan testimoni publik"
    },
    "/siteAnalytics/summary": {
      "schema": "VisitorAnalytics",
      "description": "Dokumen statistik agregat pengunjung website"
    }
  }
}
