rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['fso2cool@gmail.com', 'letithaven@gmail.com', 'alumnimansbt@gmail.com', 'ponpesalaska@gmail.com']
      );
    }

    // Public school branding images & general logos
    match /school/{fileName} {
      allow read: if true;
      allow write: if isAdmin() &&
                      request.resource.size < 10 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/.*');
    }

    // News & announcements cover photos
    match /news/{fileName} {
      allow read: if true;
      allow write: if isAdmin() &&
                      request.resource.size < 10 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/.*');
    }

    // Gallery album photos
    match /gallery/{fileName} {
      allow read: if true;
      allow write: if isAdmin() &&
                      request.resource.size < 10 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/.*');
    }

    // Teachers & staff photos
    match /teachers/{fileName} {
      allow read: if true;
      allow write: if isAdmin() &&
                      request.resource.size < 10 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/.*');
    }

    // Facilities & school infrastructure photos
    match /facilities/{fileName} {
      allow read: if true;
      allow write: if isAdmin() &&
                      request.resource.size < 10 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/.*');
    }

    // Extracurricular activities photos
    match /extracurriculars/{fileName} {
      allow read: if true;
      allow write: if isAdmin() &&
                      request.resource.size < 10 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/.*');
    }

    // Public Download Documents (PDF, doc, docx, xls, zip)
    match /documents/{fileName} {
      allow read: if true;
      allow write: if isAdmin() &&
                      request.resource.size < 30 * 1024 * 1024;
    }

    // PPDB requirement uploads (images or PDF up to 10MB)
    match /ppdb/{applicantId}/{fileName} {
      allow read: if isAdmin();
      allow write: if request.resource.size < 10 * 1024 * 1024 &&
                      (request.resource.contentType.matches('image/.*') ||
                       request.resource.contentType == 'application/pdf');
    }
  }
}
